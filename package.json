{
  "name": "axon",
  "version": "1.0.0",
  "private": true,
  "description": "Reads your note with your own Claude Code and drafts the tasks hidden in it. Tick the ones you want and Axon adds them to your self-hosted Vikunja.",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "TZ=Europe/Amsterdam vitest run",
    "test:claude": "RUN_CLAUDE_IT=1 TZ=Europe/Amsterdam vitest run tests/claude.integration.test.ts",
    "install-plugin": "node scripts/install.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@eslint/json": "0.14.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "9.36.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "marked": "18.0.14"
  }
}
