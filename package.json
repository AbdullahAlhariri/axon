{
  "name": "axon",
  "version": "0.4.0",
  "private": true,
  "description": "AI task extraction for Vikunja: Claude reads your note, drafts the reminders, and you approve what gets added.",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "TZ=Europe/Amsterdam vitest run",
    "test:claude": "RUN_CLAUDE_IT=1 TZ=Europe/Amsterdam vitest run tests/claude.integration.test.ts",
    "install-plugin": "node scripts/install.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "marked": "18.0.14"
  }
}
